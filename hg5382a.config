# HG5382A minimal PonWrt configuration
# Based on pbs05/ponwrt configs/an7581.config
# Target: Airoha AN7581 / FiberHome HG5382A
#
# Run after copying this file:
#   make defconfig
#   make -j$(nproc)
#
# Scope:
#   - Keep AN7581/PON/NAND/UBI/network/LuCI/diagnostic functions
#   - Remove Wi-Fi, USB-storage, IPTV and unrelated device hardware
#   - Keep tcpdump for troubleshooting
#
# NOTE:
# This is intentionally a compact source .config, not the 8699-line
# generated config. `make defconfig` should expand dependencies/defaults.

CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_fiberhome_hg5382a=""

CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_LINUX_6_18=y

# Root filesystem
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_SQUASHFS_BLOCK_READERS=4
CONFIG_TARGET_SQUASHFS_SMALL_READERS=4
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y

# AN7581 / PonWrt core
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_autocore=y

CONFIG_PACKAGE_kmod-airoha-en7572=m
CONFIG_PACKAGE_kmod-airoha-paged-bosa=m
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-phy-maxlinear=y

# NAND / UBI / boot environment
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# Base system
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# Ethernet / firewall / offload
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-full=y

# IPv6 / PPPoE
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# LuCI web server
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# Diagnostics
CONFIG_PACKAGE_tcpdump=y

# Explicitly disabled / intentionally omitted:
# Wi-Fi:
#   kmod-mt7915e
#   kmod-mt7916-firmware
#   znxt-zn515-mt7916-eeprom
#   wpad-openssl
#   hostapd-common
#
# USB:
#   kmod-usb-core
#   kmod-usb3
#   kmod-usb-storage
#   kmod-usb-storage-uas
#   kmod-usb-xhci-hcd
#   kmod-usb-xhci-mtk
#   block-mount
#   kmod-fs-ext4
#   kmod-fs-vfat
#   kmod-fs-exfat
#
# Other:
#   luci-app-iptv
#   luci-i18n-iptv-zh-cn
#   luci-theme-bootstrap
#   libiperf3
#   i2c-tools
#   unrelated device-specific firmware/EEPROM packages
